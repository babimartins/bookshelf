{
  "compilerOptions": {
    "target": "es2020",
    "module": "NodeNext",
    "rootDir": "./src",
    "moduleResolution": "NodeNext",
    "baseUrl": "./",
    "paths": {
      "#config/*": [
        "src/config/*"
      ],
      "#models/*": [
        "src/models/*"
      ],
      "#routes/*": [
        "src/routes/*"
      ],
      "#middlewares/*": [
        "src/middlewares/*"
      ],
      "#services/*": [
        "src/services/*"
      ],
      "#utils/*": [
        "src/utils/*"
      ]
    },
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "declaration": true,
    "outDir": "./dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}